# Copy this file to ".env" and change the values
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/node_jwt_starter

# Use long random strings in real projects (and two DIFFERENT secrets)
ACCESS_TOKEN_SECRET=change_me_access_secret
REFRESH_TOKEN_SECRET=change_me_refresh_secret

# Access token = short life, Refresh token = long life
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
